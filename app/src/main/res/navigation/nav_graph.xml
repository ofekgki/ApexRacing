<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.apexracing.ui.home.HomeMain"
        android:label="Home"/>

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.example.apexracing.ui.calendar.CalendarMain"
        android:label="Calendar"/>

    <fragment
        android:id="@+id/fantasyFragment"
        android:name="com.example.apexracing.ui.fantasy.FantasyMain"
        android:label="Fantasy"/>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.apexracing.ui.profile.ProfileMain"
        android:label="Profile">

        <action
            android:id="@+id/action_profileMain_to_editFavoritesFragment"
            app:destination="@id/editFavoritesFragment" />


    </fragment>


    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.example.apexracing.ui.explore.ExploreMain"
        android:label="Explore"/>

    <fragment
        android:id="@+id/editFavoritesFragment"
        android:name="com.example.apexracing.ui.profile.NewFavorites"
        android:label="Edit Favorites" >

        <action
            android:id="@+id/action_editFavoritesFragment_to_profileFragment"
            app:destination="@id/profileFragment" />

    </fragment>

</navigation>