<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Main red gradient -->
    <item>
        <shape>
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#FF1A1A"
                android:centerColor="#A00000"
                android:endColor="#000000"/>
        </shape>
    </item>

    <!-- Vignette shadow -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="600dp"
                android:centerX="0.5"
                android:centerY="0.3"
                android:startColor="#33000000"
                android:endColor="#99000000"/>
        </shape>
    </item>

</layer-list>
