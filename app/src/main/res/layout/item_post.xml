<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#14141C"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#2A2A35"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/post_IMG_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/user_profile_blank"
            android:padding="7dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/post_TXT_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Max Verstappen"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/post_IMG_avatar"
            app:layout_constraintTop_toTopOf="@id/post_IMG_avatar" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/post_TXT_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:text="2h ago"
            android:textColor="@color/grey_outline"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/post_IMG_avatar"
            app:layout_constraintTop_toBottomOf="@id/post_TXT_name" />



        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/post_TXT_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="What a lap! 🔥 Who do you think takes pole this weekend?"
            android:textColor="#EDEDED"
            android:textSize="14sp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/post_IMG_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <View
            android:id="@+id/post_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#2A2A35"
            app:layout_constraintTop_toBottomOf="@id/post_TXT_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Actions -->
        <LinearLayout
            android:id="@+id/post_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/post_divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/post_LBL_likesCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:text="XXX Likes"
                android:textColor="@color/grey_inline"
                android:gravity="center"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/post_BTN_like"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="❤ Like"
                android:textColor="@color/grey_inline"
                android:gravity="center"
                android:padding="10dp" />



        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
