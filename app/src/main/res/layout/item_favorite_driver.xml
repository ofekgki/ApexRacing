<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemDriver_CARD"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="16dp"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:background="@color/background_color"
        >

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/itemDriver_IMG"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shapeAppearance="@style/CircleImage"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/itemDriver_LBL_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Driver Name"
            android:textStyle="bold"
            android:textSize="@dimen/big_text_card"
            android:textColor="@color/white"
            android:layout_marginStart="@dimen/default_small_margin"
            app:layout_constraintStart_toEndOf="@id/itemDriver_IMG"
            app:layout_constraintTop_toTopOf="@id/itemDriver_IMG"
            app:layout_constraintEnd_toEndOf="parent"

            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/itemDriver_LBL_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Team / #"
            android:textSize="@dimen/medium_text_card"
            android:textColor="@color/grey_inline"
            android:layout_marginStart="@dimen/default_fragment_margin"
            app:layout_constraintStart_toEndOf="@id/itemDriver_IMG"
            app:layout_constraintTop_toBottomOf="@id/itemDriver_LBL_name"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>